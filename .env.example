# DICE Coordinator — Production Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# Generate strong values:
#   API key:     openssl rand -base64 32
#   DB password: openssl rand -base64 24

# PostgreSQL connection (required in production mode)
DATABASE_URL=postgresql://neondb_owner:npg_mr5BDTjnRFz9@ep-rough-unit-amap2seh-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# API authentication key (required — protects /simulate and other endpoints)
DICE_API_KEY=<GENERATE_WITH_openssl_rand_-base64_32>

# mTLS certificates
DICE_TLS_CERT_PATH=/etc/dice/certs/coordinator.crt
DICE_TLS_KEY_PATH=/etc/dice/certs/coordinator.key
DICE_CA_CERT_PATH=/etc/dice/certs/ca_bundle.crt

# Solana coordinator keypair (on-chain transaction signing)
DICE_KEYPAIR_PATH=/etc/dice/coordinator-keypair.json

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.devnet.solana.com

# WebSocket port for ESP32 nodes (mTLS)
DICE_WS_PORT=9001

# REST API port (behind reverse proxy)
DICE_API_PORT=8080

# Prometheus metrics port
DICE_METRICS_PORT=9090

# Rate limiting (requests per second on /simulate)
DICE_RATE_LIMIT_RPS=10

# Node configuration
DICE_MIN_NODES=4
DICE_MAX_NODES=7
DICE_COMMIT_TIMEOUT_SECS=60
DICE_REVEAL_TIMEOUT_SECS=60
