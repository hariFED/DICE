{
  "root": "/home/step/certs/root_ca.crt",
  "federatedRoots": [],
  "crt": "/home/step/certs/intermediate_ca.crt",
  "key": "/home/step/secrets/intermediate_ca_key",
  "address": ":9000",
  "dnsNames": ["step-ca", "localhost"],
  "logger": {"format": "json"},
  "db": {
    "type": "badgerV2",
    "dataSource": "/home/step/db"
  },
  "authority": {
    "provisioners": [
      {
        "type": "JWK",
        "name": "dice-provisioner@dice.network",
        "key": {
          "use": "sig",
          "kty": "EC",
          "kid": "dice-provisioner",
          "crv": "P-256",
          "alg": "ES256"
        },
        "encryptedKey": ""
      }
    ],
    "template": {
      "subject": {"commonName": "{{ .Subject.CommonName }}"},
      "sans": ["{{ .Subject.CommonName }}"],
      "keyUsage": ["digitalSignature"],
      "extKeyUsage": ["clientAuth"]
    }
  },
  "tls": {
    "cipherSuites": [
      "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
      "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
    ],
    "minVersion": 1.2,
    "maxVersion": 1.3,
    "renegotiation": false
  }
}
