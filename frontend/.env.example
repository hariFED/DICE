# DICE Frontend — public environment variables
#
# Copy to .env.local for local development, or set these in your host
# (Vercel, Netlify, systemd unit, etc.) for production. Only NEXT_PUBLIC_*
# variables are exposed to the browser, so don't put secrets here — nothing
# in this file should be sensitive.
#
# .env.local is git-ignored by default; this .env.example is safe to commit.

# Base URL of the DICE coordinator REST API.
# - Legacy direct-from-browser path (pre-BFF). New code goes through the
#   server-only COORD_INTERNAL_URL below instead.
# - Example (local):      http://localhost:8080
# - Example (production): https://coord.dice.network
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Server-only variables (never exposed to the browser) ──────────────────
# Set these in the Vercel Project → Settings → Environment Variables panel,
# NOT in a committed file. Leave blank for `pnpm dev` + run local coord.

# URL the BFF route handlers (app/api/v1/*) fetch the coord from. Can be a
# private Railway URL that's not reachable from the public internet — only
# this Vercel function has access.
COORD_INTERNAL_URL=

# Optional: POST target for /api/v1/preorder submissions. If blank, the
# handler just logs to stdout (fine for dev). Set to a Formspree /
# Supabase / Google Apps Script webhook URL for real storage.
PREORDER_FORWARD_URL=
