# DICE Frontend — public environment variables
#
# Copy to .env.local for local development, or set these in your host
# (Vercel, Netlify, systemd unit, etc.) for production. Only NEXT_PUBLIC_*
# variables are exposed to the browser, so don't put secrets here — nothing
# in this file should be sensitive.
#
# .env.local is git-ignored by default; this .env.example is safe to commit.

# Base URL of the DICE coordinator REST API.
# - The frontend polls /api/v1/stats, /nodes, /rounds, /queue from here.
# - The coordinator must have CORS enabled; v7 release binaries do.
# - Example (local):      http://localhost:8080
# - Example (production): https://coord.dice.network
NEXT_PUBLIC_API_URL=http://localhost:8080
