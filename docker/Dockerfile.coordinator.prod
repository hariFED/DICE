# DICE Coordinator Dockerfile
# Uses a multi-stage build: compile in Rust image, run in minimal Debian.
# Infra Agent owns this file.

# ─── Build stage ──────────────────────────────────────────────────────────────
# Bumped from 1.78 → 1.89: a transitive `toml_parser 1.1.2` dep now requires
# edition2024 (Cargo ≥ 1.85). Stay <1.93 to avoid anchor-syn 0.30.x drift
# (per root Cargo.toml note), well clear of that here.
FROM rust:1.89-bookworm AS builder

WORKDIR /build

# Copy the full workspace. Layer-caching the dep graph is brittle against
# new workspace members (harness crates come and go); a single COPY is
# slower on the first build but robust. Subsequent pushes reuse cached
# layers when Cargo.lock + source hashes match.
COPY . .

RUN cargo build --release --package dice-coordinator

# ─── Runtime stage ────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 && \
    rm -rf /var/lib/apt/lists/*

# Run as non-root user
RUN useradd -r -s /bin/false -u 1001 dice
USER dice

WORKDIR /app

COPY --from=builder /build/target/release/dice-coordinator /app/dice-coordinator

# Expose ports: 8443 mTLS WebSocket (nodes), 8080 REST API, 9090 Prometheus.
# Inline comments on EXPOSE break the BuildKit parser — keep them on their own line.
EXPOSE 8443
EXPOSE 8080
EXPOSE 9090

ENTRYPOINT ["/app/dice-coordinator"]
